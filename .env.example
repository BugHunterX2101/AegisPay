# Copy to .env (which is gitignored) and fill in. Nothing here is a real credential.

# --- Postgres (the API, the worker and pg-boss share it) ---
# Local dev database:  docker run -d --name aegispay-pg -p 54329:5432 -e POSTGRES_USER=aegis -e POSTGRES_PASSWORD=aegis -e POSTGRES_DB=aegis_test postgres:16
DATABASE_URL=postgres://aegis:aegis@localhost:54329/aegis_test
# Tests create an isolated schema per file in this database (defaults to the URL above).
TEST_DATABASE_URL=postgres://aegis:aegis@localhost:54329/aegis_test

# --- API ---
PORT=3000
# Public URL of the API (PayPal return links). Use the Render URL when deployed.
APP_URL=http://localhost:3000
# At least 32 random characters. Signs the session cookie and the CSRF secret.  openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-random-characters
# Judge Mode shows the demo clock and reset controls. Set to false to hide them (the routes then answer 403).
JUDGE_MODE=true

# --- PayPal (SANDBOX only: any other host is refused at startup) ---
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# The PayPal environment. Only `sandbox` is accepted (unset means sandbox); `live` stops the server at start.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Writes (create/authorize/capture/void) are off until you turn them on, so a fresh clone cannot move anything.
PAYPAL_WRITES_ENABLED=false
# From `pnpm register-webhook`, once the API has a public URL.
PAYPAL_WEBHOOK_ID=

# --- Language model for the mandate parser and the dispute-defense drafter (set one) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override.
AEGIS_LLM_MODEL=

# --- Live product catalog (Channel3) ---
CHANNEL3_API_KEY=
# CHANNEL3_BASE_URL=

# --- Optional: AG Grid Enterprise licence key (baked into the web bundle at build time; without it the grid shows a watermark) ---
VITE_AG_GRID_LICENSE_KEY=

# --- Only for scripts/render-deploy.mjs ---
RENDER_API_KEY=
